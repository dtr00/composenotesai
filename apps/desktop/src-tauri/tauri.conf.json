{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Compose Notes AI",
  "identifier": "com.composenotes.ai",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBODg2OTJGNjlFMjlFOEYKUldTUG51SnBMMm1JeWw2L3lhM2lrWjZTZkN4RUZVWDN3WjF1aVZjYTMwNmNDMlZhMFplVGM5MnMK",
      "endpoints": [
        "https://github.com/dtr00/composenotesai/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
